# Copy to .env.local and adjust. Do NOT commit .env.local.

# Database
DATABASE_URL=postgresql+asyncpg://mas:mas@localhost:5434/mas

# OIDC (dev: oidc-mock at localhost:9000/default; prod: Google Workspace)
OIDC_ISSUER=http://localhost:9000/default
OIDC_CLIENT_ID=mas-dev
OIDC_CLIENT_SECRET=dev-secret
OIDC_REDIRECT_URI=http://localhost:8001/api/auth/callback

# Session cookie signing (override in prod)
SESSION_SECRET=dev-only-not-a-real-secret

# Fernet key for integration_credential.encrypted_payload.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_SECRET=SwVcuvR4muCCE69YjMmD7zNeoSl5aknPRm9FCB4eSOc=

# HubSpot OAuth (W11, E12-S01)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8001/api/integrations/hubspot/callback

# Plausible Analytics (W16, E12-S05)
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=

# Anthropic (W17 onward — required for copywriting.generate to register)
ANTHROPIC_API_KEY=
COPYWRITING_MODEL=claude-sonnet-4-6

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mas-api

# Audience freshness (E01-S05)
AUDIENCE_MEMBER_FRESHNESS_TTL_DAYS=30
