{
  "interactiveLogin": true,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "scope",
          "match": "openid",
          "claims": {
            "email": "marketer@acme.test",
            "name": "Demo Marketer",
            "hd": "acme.test"
          }
        }
      ]
    }
  ]
}
